{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false
  },
  // Everything under src/: the library entry (lib.ts) and the CLI
  // (index.ts → the package's `chartjs2img` bin) both ship as dist/*.js.
  "include": ["src/**/*.ts"]
}
