{
  "compilerOptions": {
    "target": "ES2022",
    // nodenext: the published dist/ must run under plain Node ESM, which
    // requires explicit file extensions on relative imports. Sources import
    // siblings as `./x.ts` (Bun runs them as-is) and tsc rewrites those to
    // `./x.js` when emitting dist/ (rewriteRelativeImportExtensions).
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["bun-types"]
  },
  "include": ["src/**/*.ts"]
}
