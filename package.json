{
  "name": "chartjs2img",
  "version": "0.6.0",
  "description": "Render Chart.js charts to images via a TypeScript API, CLI, or HTTP server. Two engines: skia-canvas by default (no browser) or headless Chromium for full fidelity. Chart.js 4.4 + 12 plugins bundled.",
  "type": "module",
  "main": "./dist/lib.js",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/chart-registry.js",
    "**/chart-registry.ts"
  ],
  "bin": {
    "chartjs2img": "src/index.ts"
  },
  "keywords": [
    "chart",
    "chartjs",
    "chart.js",
    "image",
    "png",
    "jpeg",
    "webp",
    "skia",
    "skia-canvas",
    "puppeteer",
    "headless-chromium",
    "visualization",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideamans/chartjs2img.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "bun run src/index.ts serve",
    "build": "bun build src/index.ts --compile --outfile chartjs2img",
    "start": "bun run src/index.ts serve",
    "cli": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean:dist": "rm -rf dist",
    "build:lib": "bun run clean:dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build:lib",
    "build-llms-txt": "bun scripts/build-llms-txt.ts",
    "validate-plugin-skills": "bun scripts/validate-plugin-skills.ts",
    "ai:regen": "bun scripts/build-llms-txt.ts",
    "docs:examples": "bun scripts/build-docs-examples.ts",
    "docs:diagrams": "bun scripts/build-docs-diagrams.ts",
    "docs:dev": "bun run build-llms-txt && bun run docs:diagrams && vitepress dev docs",
    "docs:build": "bun run build-llms-txt && bun run docs:diagrams && bun run docs:examples && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "bun run docs:build && rsync -av docs/.vitepress/dist/ web-g6:web/vhosts/chartjs2img.ideamans.com/html/"
  },
  "dependencies": {
    "chart.js": "4.4.9",
    "chartjs-adapter-date-fns": "3.0.0",
    "chartjs-chart-geo": "4.3.3",
    "chartjs-chart-graph": "4.3.3",
    "chartjs-chart-matrix": "2.0.1",
    "chartjs-chart-sankey": "0.12.1",
    "chartjs-chart-treemap": "2.3.1",
    "chartjs-chart-venn": "4.3.3",
    "chartjs-chart-wordcloud": "4.4.3",
    "chartjs-plugin-annotation": "3.1.0",
    "chartjs-plugin-datalabels": "2.2.0",
    "chartjs-plugin-gradient": "0.6.1",
    "date-fns": "^4.4.0",
    "puppeteer-core": "^24.40.0",
    "skia-canvas": "^3.0.8"
  },
  "devDependencies": {
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "latest",
    "daisyui": "^5.5.19",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.0",
    "vitepress": "^2.0.0-alpha.17",
    "vitepress-daisyui-theme": "^0.2.1",
    "vue": "^3.5.0"
  },
  "trustedDependencies": [
    "skia-canvas"
  ]
}
